---
/**
 * BaseLayout.astro
 *
 * The document shell shared by every page: charset, viewport, fonts and the
 * design tokens. Pages supply their own page stylesheet and body content.
 *
 * `theme` picks the colour set from tokens.css and is applied to <body>, so
 * every descendant — including React islands — resolves the same token names.
 */
import '../styles/tokens.css';

interface Props {
  title: string;
  description?: string;
  /** Which colour theme from tokens.css to apply. */
  theme: 'public' | 'admin';
  /** Keep the page out of search results (admin). */
  noindex?: boolean;
  /** Site icon. Defaults to the bundled asset if a page has no settings row to read. */
  avatarUrl?: string;
}

const { title, description, theme, noindex = false, avatarUrl = '/assets/profile.jpg' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  {description && <meta name="description" content={description}>}
  {noindex && <meta name="robots" content="noindex, nofollow">}

  <!--
    The artist's avatar doubles as the site icon. Nothing was ever linked here,
    so browsers fell back to /favicon.ico (404) — and while the domain was
    parked they picked up the registrar's icon instead. Favicons are cached
    hard, so a stale one may need a forced refresh to clear.

    No `type` attribute: the avatar can now be uploaded as png/jpg/gif/webp
    (see CloudinaryUploadWidget's clientAllowedFormats), and browsers sniff
    icon type fine without it.
  -->
  <link rel="icon" href={avatarUrl}>
  <link rel="apple-touch-icon" href={avatarUrl}>

  <!-- Fonts: one request covers both themes -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,600&family=Inter:wght@400;500;600&family=Kosugi&display=swap"
    rel="stylesheet"
  >

  <slot name="head" />
</head>
<body class={`theme-${theme}`}>
  <slot />
</body>
</html>
