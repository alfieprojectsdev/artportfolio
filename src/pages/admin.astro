---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdminDashboard from '../components/admin/AdminDashboard';
import { checkAuth, unauthorizedResponse } from '../lib/auth';
import { db, siteSettings } from '../db';
import { resolveSiteConfig } from '../lib/settings';
import { env } from '../lib/env';
import '../styles/admin.css';

// Same Basic Auth check the API routes use. Previously reimplemented inline
// here, which also meant a malformed base64 header threw out of atob() and
// surfaced as a 500 instead of a 401.
if (!checkAuth(Astro.request)) {
  return unauthorizedResponse('Admin Area');
}

let settings: typeof siteSettings.$inferSelect | null = null;
try {
  const [row] = await db.select().from(siteSettings).limit(1);
  settings = row || null;
} catch (error) {
  console.error('Database connection error:', error);
}

const config = resolveSiteConfig(settings);
const cloudName = env.CLOUDINARY_CLOUD_NAME ?? '';
const uploadPreset = env.CLOUDINARY_UPLOAD_PRESET ?? '';
---

<BaseLayout title={`Admin Dashboard - ${config.artistName}'s Commissions`} theme="admin" noindex>
  <header class="admin-header">
    <h1>{config.artistName}'s Portfolio Admin</h1>
    <a href="/" target="_blank" rel="noopener">View Site &rarr;</a>
  </header>

  <AdminDashboard
    client:only="react"
    cloudName={cloudName}
    uploadPreset={uploadPreset}
  />
</BaseLayout>
