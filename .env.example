# Database (NeonDB)
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# Cloudinary
# Only these two are used — uploads are unsigned, so no API key/secret is
# needed. Don't add CLOUDINARY_API_KEY / CLOUDINARY_API_SECRET back unless
# something starts doing signed uploads.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_UPLOAD_PRESET=artportfolio-unsigned

# Admin Auth (simple password protection)
ADMIN_PASSWORD=your-secure-password

# Resend Email (optional - enables commission notifications)
# If RESEND_API_KEY is set, ARTIST_EMAIL MUST be set too: it is the inbox that
# receives new commission requests, and there is no fallback. Unset means
# notifications are skipped with a loud error, never sent into the void.
RESEND_API_KEY=re_xxxxxxxxxxxx
ARTIST_EMAIL=your-email@example.com
# resend.dev is Resend's shared sandbox domain and only delivers to your own
# verified address — client confirmation emails will be rejected. Verify a
# custom domain before relying on this in production.
FROM_EMAIL=commissions@resend.dev

# Optional: Site URL for absolute links
SITE_URL=https://your-domain.vercel.app

# Endpoint host of the PRODUCTION database branch.
# Required by the Playwright guard (e2e/guard.setup.ts), which refuses to run
# when DATABASE_URL points here. It fails closed: unset means the suite aborts.
PRODUCTION_DB_HOST=ep-your-prod-branch-pooler.region.aws.neon.tech
